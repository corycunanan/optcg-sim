async function act(Session: any, Repository: any, storage: MemorySessionStorage, action: any) {
  const loaded = (await new Repository(storage, options).load())!;
  const session = runtime(Session, storage, loaded);
  const normalized = { ...action, ...(loaded.state.pendingPrompt?.promptId ? { promptId: loaded.state.pendingPrompt.promptId } : {}) };
  const messages: any[] = [];
