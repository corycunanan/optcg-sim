+    }, 1);
+  }
+  for (const already10 of [false, true]) {
+    const r = rig(); r.state.players[0].donCostArea.forEach(d => d.state = "RESTED");
+    const restriction = r.put("OP10-030", 0, "CHARACTER");
+    const prior = already10 ? r.put("SYN-prior-schedule", 0, "CHARACTER", { schema: synSchema("SYN-prior-schedule", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "ADD_DON_FROM_DECK", params: { amount: 1, up_to: true, target_state: "RESTED" } } } }] }]) }) : null;
+    const source = r.put("SYN-queued-trash", 0, "HAND", { data: { cost: 0 }, schema: synSchema("SYN-queued-trash", [{ id: "onplay", category: "auto", trigger: { keyword: "ON_PLAY" }, costs: [{ type: "TRASH_SELF" }], actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "SET_DON_ACTIVE", params: { amount: 1, up_to: true } } } }] }]) });
+    await extra(already10 ? "loaded10-queued-TRASH_SELF-schedule" : "existing8-queued-TRASH_SELF-schedule", r, async (act, current) => {
