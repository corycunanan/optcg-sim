+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { execFileSync } from "node:child_process";
+import { gzipSync } from "node:zlib";
+import { createHash } from "node:crypto";
+import { expect, it } from "vitest";
+import { GameSession } from "../GameSession.js";
+import type { CardData, Env, GameAction, GameState } from "../types.js";
+import { SessionRepository } from "../session/persistence.js";
+import { MemorySessionStorage } from "./fixtures/opt-940-synthetic-states.js";
+import { rig, synSchema } from "./opt-960-rig.js";
+
+type Access = { gameState: GameState; cardDb: Map<string, CardData>; undoHistory: GameState[]; handleAction(ws: WebSocket, player: 0 | 1, action: GameAction): Promise<void> };
+const env = { GAME_WORKER_SECRET: "test", NEXTJS_URL: "https://app.example.test" } as Env;
+const socket = () => ({ sent: [] as string[], send(value: string) { this.sent.push(value); }, close() {} });
+function access(storage: MemorySessionStorage, state: GameState, db: Map<string, CardData>, undo: GameState[]) {
+  const durable = { storage, getWebSockets: () => [], getTags: () => [], acceptWebSocket() {} } as unknown as DurableObjectState;
+  const session = new GameSession(durable, env) as unknown as Access;
+  session.gameState = state; session.cardDb = db; session.undoHistory = undo;
+  return session;
+}
+const hash = (value: string | Buffer) => createHash("sha256").update(value).digest("hex");
+const copyStorage = (storage: MemorySessionStorage) => Object.fromEntries([...storage.data.entries()].map(([key, value]) => [key, structuredClone(value)]));
+
+it("captures isolated schema9 writer outputs through actual GameSession and repository boundaries", async () => {
+  const output = process.env.OPT1004_WRITER_CAPTURE_DIR;
+  if (!output) throw new Error("OPT1004_WRITER_CAPTURE_DIR required for isolated capture");
+  mkdirSync(output, { recursive: true });
+  const root = resolve(__dirname, "../../../..");
+  const commit = execFileSync("git", ["-C", root, "rev-parse", "HEAD"], { encoding: "utf8" }).trim();
+  execFileSync("git", ["-C", root, "diff", "--exit-code", "--", "workers/game"]);
+  const cases: Record<string, unknown> = {};
+  for (const restriction of ["OP10-030", "EB04-016", null] as const) {
+    for (const departed of [false, true]) {
+      const id = `${restriction ?? "allowed"}-${departed ? "departed" : "present"}`;
+      const r = rig(); r.state.schemaVersion = 8; r.state.costSemanticsVersion = 8;
+      r.state.players[0].donCostArea.forEach(d => d.state = "RESTED");
+      const leader = r.state.players[0].leader;
+      r.db.set(leader.cardId, { ...r.db.get(leader.cardId)!, types: ["Supernovas"] });
+      const blocker = restriction ? r.put(restriction, 0, "CHARACTER") : null;
+      const remover = r.put("SYN-bounce", 0, "CHARACTER", { schema: synSchema("SYN-bounce", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, actions: [{ type: "RETURN_TO_HAND", target: { type: "CHARACTER", controller: "SELF", count: { exact: 1 } } }] }]) });
+      const park = r.put("SYN-park", 0, "CHARACTER", { schema: synSchema("SYN-park", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "ADD_DON_FROM_DECK", params: { amount: 1, up_to: true, target_state: "RESTED" } } } }] }]) });
+      const drake = r.put("ST24-005", 0, "HAND", { data: { cost: 0 } });
+      const storage = new MemorySessionStorage();
+      const repo = new SessionRepository(storage, { nextJsUrl: env.NEXTJS_URL, workerSecret: env.GAME_WORKER_SECRET });
+      await repo.save({ state: r.state, cardDb: r.db, mode: "PVP", pregameMode: "PRIORITY_ROLL", testPriorityRolls: null, undoHistory: [structuredClone(r.state)] });
+      const initial = copyStorage(storage);
+      let session = access(storage, r.state, r.db, [structuredClone(r.state)]);
+      const steps: unknown[] = [];
+      async function act(action: GameAction) {
+        const sent = socket();
+        const normalized = { ...action, ...(session.gameState.pendingPrompt?.promptId ? { promptId: session.gameState.pendingPrompt.promptId } : {}) } as GameAction;
+        await session.handleAction(sent as unknown as WebSocket, 0, normalized);
+        expect(sent.sent.map(s => JSON.parse(s)).filter(m => m.type === "action:rejected"), id).toEqual([]);
+        steps.push({ action: normalized, player: 0, stored: copyStorage(storage) });
+        // Every continuation proceeds from the actual saved/reloaded graph.
+        const loaded = (await new SessionRepository(storage, { nextJsUrl: env.NEXTJS_URL, workerSecret: env.GAME_WORKER_SECRET }).load())!;
+        session = access(storage, loaded.state, loaded.cardDb, loaded.undoHistory);
+      }
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: park.instanceId, effectId: "main" });
+      expect(session.gameState.schemaVersion).toBe(9);
+      await act({ type: "PLAY_CARD", cardInstanceId: drake.instanceId });
+      const played = session.gameState.players[0].characters.find(c => c?.cardId === "ST24-005")!;
+      expect(session.gameState.scheduledActions.find(s => s.sourceEffectId === played.instanceId)?.sourceCardSnapshot?.cardId).toBe("ST24-005");
+      if (departed) {
+        await act({ type: "ACTIVATE_EFFECT", cardInstanceId: remover.instanceId, effectId: "main" });
+        await act({ type: "SELECT_TARGET", selectedInstanceIds: [played.instanceId] });
+      }
+      if (blocker) {
+        const block = r.db.get(blocker.cardId)!.effectSchema!.effects.find(e => e.category === "activate")!;
+        await act({ type: "ACTIVATE_EFFECT", cardInstanceId: blocker.instanceId, effectId: block.id });
+        await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:0" });
+      }
+      await act({ type: "ADVANCE_PHASE" });
+      expect(session.gameState.effectStack.some(f => f.phaseBoundaryContinuation?.remainingScheduledActions.some(s => s.sourceEffectId === played.instanceId))).toBe(true);
+      await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+      if (session.gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+      const expectedDonEvents = restriction ? 0 : 1;
+      expect(session.gameState.eventLog.filter(e => e.type === "DON_SET_ACTIVE"), id).toHaveLength(expectedDonEvents);
+      expect(session.gameState.pendingPrompt).toBeNull();
+      expect(session.gameState.turn.activePlayerIndex).toBe(1);
+      cases[id] = { initial, steps, expectedDonEvents };
+    }
+  }
+
+  async function extra(id: string, r: ReturnType<typeof rig>, drive: (act: (action: GameAction) => Promise<void>, current: () => Access) => Promise<void>, expectedDonEvents: number) {
+    r.state.schemaVersion = 8;
+    const storage = new MemorySessionStorage();
+    const options = { nextJsUrl: env.NEXTJS_URL, workerSecret: env.GAME_WORKER_SECRET };
+    await new SessionRepository(storage, options).save({ state: r.state, cardDb: r.db, mode: "PVP", pregameMode: "PRIORITY_ROLL", testPriorityRolls: null, undoHistory: [structuredClone(r.state)] });
+    const initial = copyStorage(storage);
+    let session = access(storage, r.state, r.db, [structuredClone(r.state)]);
+    const steps: unknown[] = [];
+    async function act(action: GameAction) {
+      const sent = socket();
+      const normalized = { ...action, ...(session.gameState.pendingPrompt?.promptId ? { promptId: session.gameState.pendingPrompt.promptId } : {}) } as GameAction;
+      await session.handleAction(sent as unknown as WebSocket, 0, normalized);
+      expect(sent.sent.map(s => JSON.parse(s)).filter(m => m.type === "action:rejected"), id).toEqual([]);
+      steps.push({ action: normalized, player: 0, stored: copyStorage(storage) });
+      const loaded = (await new SessionRepository(storage, options).load())!;
+      session = access(storage, loaded.state, loaded.cardDb, loaded.undoHistory);
+    }
+    await drive(act, () => session);
+    expect(session.gameState.eventLog.filter(e => e.type === "DON_SET_ACTIVE"), id).toHaveLength(expectedDonEvents);
+    cases[id] = { initial, steps, expectedDonEvents };
+  }
+  for (const type of ["Leader", "Event"] as const) {
+    const r = rig(); r.state.players[0].donCostArea.forEach(d => d.state = "RESTED");
+    const restriction = r.put("EB04-016", 0, "CHARACTER");
+    const id = `SYN-${type}-scheduler`;
+    const source = r.put(id, 0, type === "Leader" ? "LEADER" : "HAND", { data: { type, cost: 0, effectText: type === "Event" ? "[Main] Schedule DON activation." : "" }, schema: synSchema(id, [{ id: "schedule", category: type === "Leader" ? "activate" : "auto", trigger: { keyword: type === "Leader" ? "ACTIVATE_MAIN" : "MAIN_EVENT" }, actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "SET_DON_ACTIVE", params: { amount: 1, up_to: true } } } }] }], type) });
+    await extra(`allowed-${type}`, r, async (act, current) => {
+      await act(type === "Leader" ? { type: "ACTIVATE_EFFECT", cardInstanceId: source.instanceId, effectId: "schedule" } : { type: "PLAY_CARD", cardInstanceId: source.instanceId });
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: restriction.instanceId, effectId: "activate_set_don_active" });
+      await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:0" });
+      await act({ type: "ADVANCE_PHASE" });
+      if (current().gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+    }, 1);
+  }
+  for (const already9 of [false, true]) {
+    const r = rig(); r.state.players[0].donCostArea.forEach(d => d.state = "RESTED");
+    const restriction = r.put("OP10-030", 0, "CHARACTER");
+    const prior = already9 ? r.put("SYN-prior-schedule", 0, "CHARACTER", { schema: synSchema("SYN-prior-schedule", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "ADD_DON_FROM_DECK", params: { amount: 1, up_to: true, target_state: "RESTED" } } } }] }]) }) : null;
+    const source = r.put("SYN-queued-trash", 0, "HAND", { data: { cost: 0 }, schema: synSchema("SYN-queued-trash", [{ id: "onplay", category: "auto", trigger: { keyword: "ON_PLAY" }, costs: [{ type: "TRASH_SELF" }], actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "SET_DON_ACTIVE", params: { amount: 1, up_to: true } } } }] }]) });
+    await extra(already9 ? "loaded9-queued-TRASH_SELF-schedule" : "existing8-queued-TRASH_SELF-schedule", r, async (act, current) => {
+      if (prior) {
+        await act({ type: "ACTIVATE_EFFECT", cardInstanceId: prior.instanceId, effectId: "main" });
+        expect(current().gameState.schemaVersion).toBe(9);
+      }
+      await act({ type: "PLAY_CARD", cardInstanceId: source.instanceId });
+      expect(current().gameState.schemaVersion).toBe(9);
+      const obligation = current().gameState.scheduledActions.find(s => s.sourceCardSnapshot?.cardId === source.cardId)!;
+      expect(obligation.sourceCardSnapshot?.cardId).toBe(source.cardId);
+      expect(current().gameState.players[0].characters.some(c => c?.cardId === source.cardId)).toBe(false);
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: restriction.instanceId, effectId: "activate_set_don_active_then_prohibit" });
+      await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:0" });
+      await act({ type: "ADVANCE_PHASE" });
+      if (current().gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+      if (current().gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+    }, 0);
+  }
+  {
+    const r = rig();
+    const scheduler = r.put("SYN-cost-schedule", 0, "CHARACTER", { schema: synSchema("SYN-cost-schedule", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "SET_DON_ACTIVE", params: { amount: 1, up_to: true } } } }] }]) });
+    const payer = r.put("SYN-cost-payer", 0, "CHARACTER", { schema: synSchema("SYN-cost-payer", [{ id: "main", category: "activate", trigger: { keyword: "ACTIVATE_MAIN" }, costs: [{ type: "REST_DON", amount: 1 }, { type: "DON_MINUS", amount: 1 }], actions: [{ type: "DRAW", params: { amount: 1 } }] }]) });
+    await extra("scheduled-COST-roots", r, async (act, current) => {
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: scheduler.instanceId, effectId: "main" });
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: payer.instanceId, effectId: "main" });
+      expect(current().gameState.effectStack.some(f => f.costTransactionState && f.costExpectedRoot)).toBe(true);
+      const choices = current().gameState.pendingPrompt!.options;
+      if (choices.promptType !== "PLAYER_CHOICE") throw new Error("expected DON identity choice");
+      // Prefer returning the rested DON so the later activation has no target.
+      await act({ type: "PLAYER_CHOICE", choiceId: choices.choices[0].id });
+      await act({ type: "ADVANCE_PHASE" });
+      if (current().gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:0" });
+    }, 0);
+  }
+
+  for (const mode of [6, 7, 8] as const) {
+    const r = rig(); r.state.costSemanticsVersion = mode;
+    r.state.players[0].donCostArea.forEach(d => d.state = "RESTED");
+    const restriction = r.put("OP10-030", 0, "CHARACTER");
+    const source = r.put("SYN-paused-origin", 0, "HAND", { data: { cost: 0 }, schema: synSchema("SYN-paused-origin", [{ id: "onplay", category: "auto", trigger: { keyword: "ON_PLAY" }, costs: [{ type: "TRASH_SELF" }, { type: "TRASH_FROM_HAND", amount: 1 }], actions: [{ type: "SCHEDULE_ACTION", params: { timing: "END_OF_THIS_TURN", action: { type: "SET_DON_ACTIVE", params: { amount: 1, up_to: true } } } }] }]) });
+    r.put("CHAR-VANILLA", 0, "HAND"); r.put("CHAR-RUSH", 0, "HAND");
+    await extra(`existing8-paused-queued-origin-mode${mode}`, r, async (act, current) => {
+      await act({ type: "PLAY_CARD", cardInstanceId: source.instanceId });
+      expect(current().gameState.schemaVersion).toBe(9);
+      expect(current().gameState.costSemanticsVersion).toBe(mode);
+      expect(current().gameState.pendingPrompt).not.toBeNull();
+      const paymentState = current().gameState.effectStack.find(f => f.costTransactionState)?.costTransactionState ?? current().gameState;
+      expect(paymentState.players[0].characters.some(c => c?.cardId === source.cardId)).toBe(false);
+      expect(current().gameState.scheduledActions).toHaveLength(0);
+      await act({ type: "SELECT_TARGET", selectedInstanceIds: [current().gameState.players[0].hand[0].instanceId] });
+      expect(current().gameState.scheduledActions[0].sourceCardSnapshot?.cardId).toBe(source.cardId);
+      expect(current().gameState.costSemanticsVersion).toBe(mode);
+      await act({ type: "ACTIVATE_EFFECT", cardInstanceId: restriction.instanceId, effectId: "activate_set_don_active_then_prohibit" });
+      await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:0" });
+      await act({ type: "ADVANCE_PHASE" });
+      if (current().gameState.pendingPrompt) await act({ type: "PLAYER_CHOICE", choiceId: "choose-value:1" });
+      expect(current().gameState.costSemanticsVersion).toBe(mode);
+    }, 0);
+  }
+  writeFileSync(resolve(output, "cases.json.gz"), gzipSync(JSON.stringify({ provenance: "real GameSession pipeline in synthetic environment; no production capture", cases })));
+  const sources = execFileSync("git", ["-C", root, "ls-files", "workers/game/src/engine", "workers/game/src/session", "workers/game/src/GameSession.ts", "workers/game/src/types.ts", "workers/game/src/__tests__/opt-1004-writer-producer.test.ts", "workers/game/src/__tests__/opt-960-rig.ts", "workers/game/src/__tests__/helpers.ts"], { encoding: "utf8" }).trim().split("\n");
+  const sourceHashes = Object.fromEntries(sources.map(file => [file, hash(readFileSync(resolve(root, file)))]));
+  writeFileSync(resolve(output, "manifest.json"), JSON.stringify({ producerCommit: commit, readerBase: "66df1d56f4768790c8f8f9eaaab0623c33abd251", provenance: "synthetic-only exception for OPT-1004; no production DO capture", caseCount: Object.keys(cases).length, snapshots: Object.values(cases).reduce<number>((n, value) => n + 1 + (value as { steps: unknown[] }).steps.length, 0), fixtures: { "cases.json.gz": hash(readFileSync(resolve(output, "cases.json.gz"))) }, sourceHashes }, null, 2) + "\n");
+});
