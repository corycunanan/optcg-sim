diff --git a/workers/game/src/engine/battle-completion-contract.ts b/workers/game/src/engine/battle-completion-contract.ts
new file mode 100644
index 00000000..25efd2c3
--- /dev/null
+++ b/workers/game/src/engine/battle-completion-contract.ts
@@ -0,0 +1,75 @@
+import type { EffectStackFrame, GameState } from "../types.js";
+
+const boundaryKeys = new Set([
+  "id",
+  "sourceCardInstanceId",
+  "controller",
+  "kind",
+  "battleCompletion",
+  "effectBlock",
+  "phase",
+  "pausedAction",
+  "remainingActions",
+  "resultRefs",
+  "validTargets",
+  "costs",
+  "currentCostIndex",
+  "costsPaid",
+  "oncePerTurnMarked",
+  "costResultRefs",
+  "pendingTriggers",
+  "simultaneousTriggers",
+  "accumulatedEvents",
+]);
+
+/** One exact obligation; no choices, executable suffix or publication debt. */
+export function battleCompletionOwnerViolation(
+  frame: EffectStackFrame,
+  state: GameState
+): string | null {
+  const completion = frame.battleCompletion;
+  if (!completion) return "missing battle completion identity";
+  if (
+    state.turn.battle ||
+    state.turn.battleSubPhase !== null ||
+    state.turn.phase !== "MAIN"
+  )
+    return "battle completion requires a cleared battle in MAIN";
+  if (
+    completion.turnPlayerIndex !== state.turn.activePlayerIndex ||
+    completion.turnNumber !== state.turn.number ||
+    frame.controller !== completion.turnPlayerIndex ||
+    frame.sourceCardInstanceId !== completion.attackerInstanceId
+  )
+    return "battle completion identity disagrees with turn or source";
+  if (
+    state.effectStack.filter((f) => f.battleCompletion).length !== 1 ||
+    state.effectStack[0] !== frame
+  )
+    return "battle completion must be the unique root boundary";
+  if (
+    Object.keys(frame).some((key) => !boundaryKeys.has(key)) ||
+    frame.phase !== "INTERRUPTED_BY_TRIGGERS" ||
+    frame.pausedAction !== null ||
+    frame.currentCostIndex !== 0 ||
+    !frame.costsPaid ||
+    !frame.oncePerTurnMarked ||
+    frame.effectBlock.id !== "__engine_continuation__" ||
+    frame.effectBlock.category !== "auto" ||
+    Object.keys(frame.effectBlock).some(
+      (key) => key !== "id" && key !== "category"
+    ) ||
+    [
+      frame.remainingActions,
+      frame.resultRefs,
+      frame.validTargets,
+      frame.costs,
+      frame.costResultRefs,
+      frame.pendingTriggers,
+      frame.simultaneousTriggers,
+      frame.accumulatedEvents,
+    ].some((entries) => entries.length > 0)
+  )
+    return "battle completion carries unrelated executable work";
+  return null;
+}
diff --git a/workers/game/src/engine/battle-completion.ts b/workers/game/src/engine/battle-completion.ts
new file mode 100644
index 00000000..a761bdb9
--- /dev/null
+++ b/workers/game/src/engine/battle-completion.ts
@@ -0,0 +1,78 @@
+import { battleCompletionOwnerViolation } from "./battle-completion-contract.js";
+/** Native8 completion barrier: committed EOB events are separate from the
+ * uncommitted expiry/return-to-Main obligation. Ordinary6/7 never create it. */
+import type {
+  BattleCompletionContinuation,
+  ExecuteResult,
+  GameState,
+} from "../types.js";
+import {
+  continuationBoundary,
+  popFrame,
+  prependFrame,
+} from "./effect-stack.js";
+import { expireBattleEffects } from "./duration-tracker.js";
+import { terminateForEngineContract } from "./engine-limits.js";
+
+export function parkBattleCompletion(
+  state: GameState,
+  completion: BattleCompletionContinuation
+): GameState {
+  if (
+    state.schemaVersion !== 8 ||
+    state.effectStack.some((frame) => frame.battleCompletion)
+  ) {
+    return terminateForEngineContract(state, {
+      kind: "ENGINE_CONTRACT",
+      contract: "ACTION_HANDLER",
+      message: "Battle completion requires one native8 owner",
+    });
+  }
+  const boundary = continuationBoundary(
+    state,
+    completion.attackerInstanceId,
+    completion.turnPlayerIndex
+  );
+  // Existing trigger execution can already own other generations. Completion
+  // must sit below that whole owner, including its later reports and children.
+  return prependFrame(boundary.state, {
+    ...boundary.frame,
+    battleCompletion: completion,
+  });
+}
+
+export function completeBattleBoundary(state: GameState): ExecuteResult {
+  const frame = state.effectStack.at(-1);
+  const completion = frame?.battleCompletion;
+  if (
+    !completion ||
+    state.schemaVersion !== 8 ||
+    state.effectStack.length !== 1 ||
+    battleCompletionOwnerViolation(frame!, state) !== null
+  ) {
+    return {
+      state: terminateForEngineContract(state, {
+        kind: "ENGINE_CONTRACT",
+        contract: "ACTION_HANDLER",
+        message: "Battle completion lost its exact battle/turn boundary",
+      }),
+      events: [],
+    };
+  }
+  // Consume the sole obligation before expiry and before reporting anything it
+  // releases. A child raised by the completion notification cannot replay it.
+  let next = popFrame(state);
+  next = expireBattleEffects(next, completion.battleId, "TURN_PLAYER");
+  next = expireBattleEffects(next, completion.battleId, "NON_TURN_PLAYER");
+  return {
+    state: next,
+    events: [
+      { type: "BATTLE_RESOLVED", playerIndex: completion.turnPlayerIndex },
+      {
+        type: "PHASE_CHANGED",
+        playerIndex: completion.turnPlayerIndex,
+        payload: { from: "DAMAGE_STEP", to: "MAIN" },
+      },
+    ],
+  };
+}
